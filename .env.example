# ---------------------------------------------------------------------------
# ScousGiftCardExchange — environment configuration example
#
# Copy to `.env` for local work. The real `.env` in this project is generated
# and kept up to date automatically by Lovable Cloud — you do not need to edit
# it. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Backend (Lovable Cloud / Postgres) — used in the browser ---------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Backend — server side only (never exposed to the browser) -------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
# Managed by Lovable Cloud; not readable or settable by hand.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery ---------------------------------------------------------
# Sign-up codes, login codes and welcome emails need a verified sending domain.
# Until one is connected, emails are skipped and accounts are verified instantly.
MAIL_FROM_NAME=ScousGiftCardExchange
MAIL_FROM_EMAIL=no-reply@yourdomain.com

# --- Admin ------------------------------------------------------------------
# Seed code used once to create the first admin account.
ADMIN_SEED_CODE=197200

# --- MongoDB (NOT IN USE) ---------------------------------------------------
# Kept here only for reference if you ever migrate old data across.
# This app's server runs on an edge runtime that cannot open the direct
# database connection MongoDB drivers require, so these values are ignored by
# the app. All live data lives in the Lovable Cloud Postgres database above.
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
# MONGODB_DB=scousgiftcardexchange
